# Contact-form backend — set these in Vercel (Settings → Environment
# Variables) and redeploy; NEXT_PUBLIC_* values are inlined at build time.

# Preferred: Google Form. The site form posts straight into the form,
# whose linked Google Sheet becomes the submissions dashboard.
# 1. Take the form's "Get pre-filled link" URL
# 2. ACTION  = the URL up to /viewform, with /viewform → /formResponse
# 3. ENTRY_* = the entry.NNNN parameter names, in question order
NEXT_PUBLIC_GFORM_ACTION=https://docs.google.com/forms/d/e/FORM_ID/formResponse
NEXT_PUBLIC_GFORM_ENTRY_NAME=entry.1111111111
NEXT_PUBLIC_GFORM_ENTRY_EMAIL=entry.2222222222
NEXT_PUBLIC_GFORM_ENTRY_ORG=entry.3333333333
NEXT_PUBLIC_GFORM_ENTRY_ROLE=entry.4444444444

# Alternative: any Formspree-style JSON endpoint. Used only when the
# Google Form vars above are absent. With neither set, the submit button
# falls back to opening the visitor's mail client (mailto).
# NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/XXXXXXXX
